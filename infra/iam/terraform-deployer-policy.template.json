{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetConsoleOutput", "rds:Describe*", "s3:ListAllMyBuckets", "iam:Get*", "iam:List*", "logs:Describe*", "ssm:GetParameter", "budgets:ViewBudget"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:GetKeyPolicy", "kms:PutKeyPolicy", "kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey*", "kms:CreateGrant", "kms:ListGrants", "kms:RetireGrant", "kms:TagResource", "kms:UntagResource"],
      "Resource": "${KMS_KEY_ARN}"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:Get*", "s3:PutBucketTagging", "s3:PutBucketPublicAccessBlock", "s3:PutBucketVersioning", "s3:PutEncryptionConfiguration", "s3:PutLifecycleConfiguration", "s3:DeleteBucket", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": ["arn:aws:s3:::${LAB_BUCKET_NAME}", "arn:aws:s3:::${LAB_BUCKET_NAME}/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:GetEncryptionConfiguration"],
      "Resource": "arn:aws:s3:::${STATE_BUCKET_NAME}"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${STATE_BUCKET_NAME}/lab-ec2/terraform.tfstate*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::${LAB_BUCKET_NAME}"
    },
    {
      "Effect": "Allow",
      "Action": ["rds:CreateDBInstance", "rds:DeleteDBInstance", "rds:ModifyDBInstance", "rds:CreateDBParameterGroup", "rds:DeleteDBParameterGroup", "rds:ModifyDBParameterGroup", "rds:CreateDBSubnetGroup", "rds:DeleteDBSubnetGroup", "rds:ModifyDBSubnetGroup", "rds:AddTagsToResource", "rds:RemoveTagsFromResource", "rds:ListTagsForResource", "ssm:PutParameter", "ssm:DeleteParameter", "ssm:AddTagsToResource", "ssm:RemoveTagsFromResource", "ssm:ListTagsForResource"],
      "Resource": ["arn:aws:rds:ap-south-1:${ACCOUNT_ID}:db:olist-lakehouse-lab", "arn:aws:rds:ap-south-1:${ACCOUNT_ID}:pg:olist-lakehouse-lab-*", "arn:aws:rds:ap-south-1:${ACCOUNT_ID}:subgrp:olist-lakehouse-lab-db", "arn:aws:ssm:ap-south-1:${ACCOUNT_ID}:parameter/olist-lakehouse-lab/*"]
    },
    {
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": ["arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:instance/i-044d06ac25bba9281", "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"]
    },
    {
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:DescribeInstanceInformation"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:ap-south-1::image/ami-05549a26c58f42597", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:subnet/subnet-0c1a42f46b74d89d9", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:security-group/sg-084d69a6dae887a8a"],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:network-interface/*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1"}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:instance/i-044d06ac25bba9281"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateVpc", "ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateInternetGateway", "ec2:CreateSecurityGroup", "ec2:RunInstances", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-south-1", "aws:RequestTag/Project": "olist-lakehouse-lab"}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:ModifyVpcAttribute",
      "Resource": "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:vpc/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "olist-lakehouse-lab"}}
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateSecurityGroup", "ec2:CreateRouteTable"],
      "Resource": "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:vpc/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "olist-lakehouse-lab"}}
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AttachInternetGateway",
      "Resource": ["arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:internet-gateway/*", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:vpc/*"],
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "olist-lakehouse-lab"}}
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:DeleteInternetGateway", "ec2:DetachInternetGateway", "ec2:ModifySubnetAttribute", "ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress", "ec2:DeleteSecurityGroup", "ec2:DeleteSubnet", "ec2:DeleteRouteTable", "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute"],
      "Resource": ["arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:internet-gateway/*", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:subnet/*", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:security-group/*", "arn:aws:ec2:ap-south-1:${ACCOUNT_ID}:route-table/*"],
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "olist-lakehouse-lab"}}
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:TagResource", "logs:UntagResource", "logs:ListTagsForResource", "budgets:CreateBudget", "budgets:ModifyBudget", "budgets:DeleteBudget", "budgets:TagResource", "budgets:UntagResource", "budgets:ListTagsForResource"],
      "Resource": ["arn:aws:logs:ap-south-1:${ACCOUNT_ID}:log-group:/olist-lakehouse-lab/bootstrap", "arn:aws:logs:ap-south-1:${ACCOUNT_ID}:log-group:/olist-lakehouse-lab/bootstrap:*", "arn:aws:budgets::${ACCOUNT_ID}:budget/olist-lakehouse-lab-hard-review"]
    },
    {
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:TagRole", "iam:UntagRole", "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile", "iam:UntagInstanceProfile"],
      "Resource": ["arn:aws:iam::${ACCOUNT_ID}:role/olist-lakehouse-lab-kafka-*", "arn:aws:iam::${ACCOUNT_ID}:instance-profile/olist-lakehouse-lab-kafka-*"]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/olist-lakehouse-lab-kafka-*",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    }
  ]
}
