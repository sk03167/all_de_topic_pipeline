#!/usr/bin/env bash
# This bootstrap intentionally installs services directly on Amazon Linux 2023.
# It is a lab implementation: production uses private networking, TLS, secrets
# rotation, immutable images, and separate service hosts.
set -euo pipefail
exec > >(tee /var/log/olist-bootstrap.log | logger -t olist-bootstrap) 2>&1

# Be explicit instead of relying on an AMI default: this is the only remote
# administration path for the lab, so no SSH key pair is required.
dnf install -y amazon-ssm-agent
systemctl enable --now amazon-ssm-agent
dnf update -y
dnf install -y java-17-amazon-corretto-headless python3-pip postgresql15 awscli curl tar gettext

id kafka &>/dev/null || useradd --system --home /opt/kafka --shell /sbin/nologin kafka

# Kafka runs in KRaft mode: no ZooKeeper is required for a one-node learning lab.
KAFKA_VERSION="3.8.0"
# Old Kafka releases live in the Apache archive.  Bound the transfer so a
# transient mirror failure fails bootstrap visibly instead of blocking cloud-init.
curl --fail --location --connect-timeout 20 --max-time 900 --retry 2 \
  "https://archive.apache.org/dist/kafka/$${KAFKA_VERSION}/kafka_2.13-$${KAFKA_VERSION}.tgz" \
  --output /tmp/kafka.tgz
tar -xzf /tmp/kafka.tgz -C /opt
ln -sfn "/opt/kafka_2.13-$${KAFKA_VERSION}" /opt/kafka
mkdir -p /var/lib/kafka /etc/kafka
chown -R kafka:kafka /opt/kafka /var/lib/kafka

cat >/etc/kafka/server.properties <<'EOF'
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@localhost:9093
listeners=PLAINTEXT://0.0.0.0:9092,CONTROLLER://localhost:9093
advertised.listeners=PLAINTEXT://REPLACE_PUBLIC_DNS:9092
controller.listener.names=CONTROLLER
inter.broker.listener.name=PLAINTEXT
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
log.dirs=/var/lib/kafka
num.partitions=3
auto.create.topics.enable=false
EOF
# Terraform requires IMDSv2 by default. Fetch a token first so the broker can
# advertise its reachable public DNS without storing that endpoint in state.
IMDS_TOKEN=$$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' || true)
PUBLIC_DNS=$$(curl -fsS -H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" \
  http://169.254.169.254/latest/meta-data/public-hostname || true)
sed -i "s/REPLACE_PUBLIC_DNS/$${PUBLIC_DNS:-localhost}/" /etc/kafka/server.properties
CLUSTER_ID=$$(/opt/kafka/bin/kafka-storage.sh random-uuid)
/opt/kafka/bin/kafka-storage.sh format -t "$${CLUSTER_ID}" -c /etc/kafka/server.properties

cat >/etc/systemd/system/kafka.service <<'EOF'
[Unit]
Description=Apache Kafka (KRaft lab broker)
After=network.target
[Service]
User=kafka
Environment="KAFKA_HEAP_OPTS=-Xms512m -Xmx512m"
ExecStart=/opt/kafka/bin/kafka-server-start.sh /etc/kafka/server.properties
Restart=always
[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now kafka

# Plugin and Karapace installation are version-pinned by scripts/install-services.sh
# after bootstrap. Keeping those artifacts in the repository makes connector changes reviewable.
mkdir -p /opt/olist-lakehouse
cat >/opt/olist-lakehouse/runtime.env <<EOF
DB_HOST=${database_endpoint}
DB_NAME=${database_name}
DB_USER=${database_username}
DB_PASSWORD_PARAMETER=${database_secret_arn}
PROJECT_NAME=${project_name}
EOF
chmod 600 /opt/olist-lakehouse/runtime.env
